# Copy to Railway Variables (do not commit real values)

PORT=3000
NODE_ENV=production

# --- Neon PostgreSQL (Railway) ---
# POOLED URL (for the running app) — hostname contains "-pooler"
# Use sslmode=require ONLY. Do NOT use channel_binding=require on Railway.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=5

# DIRECT URL (for prisma migrate deploy) — same host WITHOUT "-pooler"
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Minimum 32 characters
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars

JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Gmail SMTP (Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="MYDoc <your@gmail.com>"
PASSWORD_RESET_CODE_EXPIRES_IN=15m

# Appointment wall-clock timezone (minutes east of UTC). Morocco = 60.
APP_TZ_OFFSET_MINUTES=60
