{
  "expo": {
    "name": "MYDoc",
    "slug": "mydoc",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./mobile/assets/android-icon-foreground.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./mobile/assets/android-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F4FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mydoc.appp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./mobile/assets/android-icon-foreground.png",
        "backgroundColor": "#E8F4FC"
      },
      "package": "com.mydoc.appp",
      "versionCode": 2,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./mobile/assets/android-icon-foreground.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      "expo-asset",
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withAndroidCleartext.js"
    ],
    "extra": {
      "apiUrl": "http://197.140.142.178/api",
      "socketUrl": "http://197.140.142.178",
      "eas": {
        "projectId": "9900ac58-1334-464b-ab3e-8b6335978d3f"
      }
    },
    "owner": "moppl"
  }
}
