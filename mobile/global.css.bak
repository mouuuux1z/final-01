@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Tajawal:wght@400;500;700&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ─── 1. App Root — Night Starfield ─── */
html,
body,
#root {
  min-height: 100vh;
  margin: 0;
  background-color: #090a0f;
  background-image: radial-gradient(ellipse at bottom, #321b35 0%, #090a0f 100%);
  background-attachment: fixed;
}

.starfield-layer--slow {
  animation: animStar 50s linear infinite;
}

.starfield-layer--medium {
  animation: animStar 100s linear infinite;
}

.starfield-layer--fast {
  animation: animStar 150s linear infinite;
}

@keyframes animStar {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-2000px);
  }
}

html[lang='ar'] body {
  font-family: 'Tajawal', sans-serif;
}

html[lang='en'] body,
html[lang='fr'] body {
  font-family: 'Inter', sans-serif;
}

/* ─── 4. Typography (on solid cards / surfaces) ─── */
.text-heading {
  color: #090f20;
  font-weight: 700;
}

.text-body {
  color: #7a8293;
  font-weight: 400;
}

.text-on-sky {
  color: #f4f7fe;
  font-weight: 700;
}

.text-on-sky-muted {
  color: #b8c0d0;
  font-weight: 400;
}

html[lang='ar'] .text-heading,
html[lang='ar'] .text-body {
  font-family: 'Tajawal', sans-serif;
}

html[lang='en'] .text-heading,
html[lang='en'] .text-body,
html[lang='fr'] .text-heading,
html[lang='fr'] .text-body {
  font-family: 'Inter', sans-serif;
}

/* ─── Starfield helpers (stack scenes) ─── */
.mesh-sky-bg,
.mesh-sky-surface {
  background-color: #090a0f;
  background-image: radial-gradient(ellipse at bottom, #321b35 0%, #090a0f 100%);
}

.mesh-sky-fixed {
  background-attachment: fixed;
}

/* ─── 2. Solid Cards & Surfaces ─── */
.glass-surface,
.glass-card {
  background: #ffffff;
  border: 1px solid #e8eef8;
  border-radius: 28px;
  box-shadow: 0px 6px 16px rgba(9, 15, 32, 0.08);
}

.glass-card input,
.glass-card textarea {
  color: #090f20 !important;
  -webkit-text-fill-color: #090f20;
  caret-color: #0066ff;
  background-color: #ffffff !important;
  border: 1px solid #e8eef8 !important;
}

.glass-card input::placeholder,
.glass-card textarea::placeholder {
  color: #7a8293;
  opacity: 1;
}

.glass-card input:-webkit-autofill,
.glass-card input:-webkit-autofill:hover,
.glass-card input:-webkit-autofill:focus {
  -webkit-text-fill-color: #090f20;
  box-shadow: 0 0 0 1000px #ffffff inset;
  transition: background-color 9999s ease-out 0s;
}

/* React Native Web Switch — fix absolute overlay breaking layout/clicks */
.switch-control {
  min-width: 51px;
  min-height: 31px;
  flex-shrink: 0;
}

.switch-control input[role='switch'] {
  position: relative !important;
  inset: auto !important;
  top: auto !important;
  right: auto !important;
  bottom: auto !important;
  left: auto !important;
  width: 51px !important;
  height: 31px !important;
  margin: 0 !important;
  padding: 0 !important;
  cursor: pointer;
  opacity: 1;
}

.bottom-nav-menu {
  border-radius: 28px;
  background: #ffffff;
  border: 1px solid #e8eef8;
  box-shadow: 0px 6px 16px rgba(9, 15, 32, 0.08);
}

.bottom-nav-menu .menu {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 52px;
}

/* ─── 3. Bottom nav items & active state ─── */
.bottom-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 48px;
  border-radius: 24px;
  gap: 4px;
  transform-origin: center center;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.bottom-nav-item--active {
  background-color: #0066ff !important;
  color: #ffffff;
  box-shadow: 0px 8px 20px rgba(0, 102, 255, 0.25);
}

.bottom-nav-item:hover:not(.bottom-nav-item--active) {
  background-color: rgba(0, 102, 255, 0.05);
  color: #0066ff;
}

/* ─── 3. Buttons ─── */
.btn-primary {
  background: #0066ff;
  color: #ffffff;
  border-radius: 24px;
  box-shadow: 0px 8px 20px rgba(0, 102, 255, 0.25);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-primary:hover {
  box-shadow: 0px 10px 24px rgba(0, 102, 255, 0.32);
}

/* ─── 5. Micro-interactions ─── */
.press-scale {
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.press-scale:active {
  transform: scale(0.93);
}
