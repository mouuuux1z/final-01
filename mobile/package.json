{
  "name": "mydoc-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "cd .. && expo start --web --port 8082",
    "web:clear": "cd .. && expo start --web --port 8082 --clear",
    "lint": "tsc --noEmit",
    "build:apk": "cd .. && powershell -ExecutionPolicy Bypass -File scripts/prebuild-apk.ps1",
    "build:aab": "cd .. && powershell -ExecutionPolicy Bypass -File scripts/prebuild-aab.ps1",
    "build:aab": "eas build --platform android --profile production --non-interactive",
    "build:android": "eas build --platform android --profile preview --non-interactive && eas build --platform android --profile production --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/red-hat-display": "^0.4.1",
    "@expo-google-fonts/tajawal": "^0.4.1",
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@tanstack/react-query": "^5.74.4",
    "axios": "^1.9.0",
    "expo": "~52.0.47",
    "expo-asset": "~11.0.5",
    "expo-barcode-generator": "^4.0.0",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "^0.13.3",
    "expo-constants": "~17.0.8",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-localization": "~16.0.1",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "i18next": "^25.0.2",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.4.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.8.3"
  },
  "private": true
}
